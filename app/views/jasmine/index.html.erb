<div class="test-cases">
  <% Lookbook.previews.each do |preview| %>
    <% preview.send(:scenario_entities).each do |scenario| %>
      <template data-test-case="<%= preview.lookup_path %>--<%= scenario.name %>">
        <%= render_preview_scenario(preview, scenario) %>
      </template>
    <% end %>
  <% end %>
</div>

<div class="view-component-test-cases">
  <% CounterComponentPreview.examples.each do |scenario| %>
    <template data-test-case-vc="vc-counter--<%= scenario %>">
      <%= render_preview(scenario, from: CounterComponentPreview) %>
    </template>
  <% end %>
</div>
